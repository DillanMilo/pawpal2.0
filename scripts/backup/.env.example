# Copy to scripts/backup/.env for local runs. Never commit the populated file.
PAWPAL_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@HOST:5432/postgres

# Server-only S3 credentials generated in Supabase Storage > S3.
PAWPAL_SOURCE_S3_ENDPOINT=https://esrxaniydzgzxxxwzqca.storage.supabase.co/storage/v1/s3
PAWPAL_SOURCE_S3_REGION=us-east-1
PAWPAL_SOURCE_S3_ACCESS_KEY_ID=
PAWPAL_SOURCE_S3_SECRET_ACCESS_KEY=

# Cloudflare R2 destination in a separate account/security boundary.
PAWPAL_BACKUP_S3_URI=s3://pawpal-production-backups/production
PAWPAL_BACKUP_S3_REGION=auto
PAWPAL_BACKUP_S3_ENDPOINT=https://c1bfa42998fb4d838007cdf476bbf92e.r2.cloudflarestorage.com
PAWPAL_BACKUP_S3_ACCESS_KEY_ID=
PAWPAL_BACKUP_S3_SECRET_ACCESS_KEY=

# Store this in a password manager independently of both storage accounts.
PAWPAL_BACKUP_ENCRYPTION_PASSPHRASE=
